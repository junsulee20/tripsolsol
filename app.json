{
  "expo": {
    "name": "tripsolsol",
    "slug": "tripsolsol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/applogo.png",
    "scheme": "tripsolsol",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.jeehana.tripsolsol",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "영수증을 스캔하기 위해 카메라 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "영수증 이미지를 선택하기 위해 갤러리 접근 권한이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "사진을 저장하기 위해 갤러리 접근 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/applogo.png",
        "backgroundColor": "#ffffff",
        "foregroundImageScale": 0.5
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jeehana.tripsolsol",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/applogo.png",
      "bundler": "metro",
      "output": "static",
      "display": "fullscreen",
      "themeColor": "#4A90E2",
      "backgroundColor": "#ffffff",
      "orientation": "portrait",
      "startUrl": "/",
      "shortName": "TripSolSol",
      "lang": "ko",
      "scope": "/",
      "dir": "ltr"
    },
    "splash": {
      "image": "./assets/images/applogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/applogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "영수증을 스캔하기 위해 카메라 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "영수증 이미지를 선택하기 위해 갤러리 접근 권한이 필요합니다.",
          "cameraPermission": "영수증을 촬영하기 위해 카메라 권한이 필요합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "영수증 이미지를 선택하기 위해 갤러리 접근 권한이 필요합니다.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.ttf",
            "./assets/fonts/Pretendard-Medium.ttf", 
            "./assets/fonts/Pretendard-SemiBold.ttf",
            "./assets/fonts/Pretendard-Bold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92451242-2047-4d5c-8083-852da873e664"
      },
      "exchangeApiKey": "EKqvkPcQXQukgtH8tVtmPH7AQkSwcBHE"
    },
    "owner": "junsulee20"
  }
}
