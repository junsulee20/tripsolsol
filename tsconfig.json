{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./*"],
            "@hooks/*": ["./hooks/*"],
            "@components/*": ["./components/*"],
            "@services/*": ["./services/*"],
            "@config/*": ["./config/*"],
            "@types/*": ["./types/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
